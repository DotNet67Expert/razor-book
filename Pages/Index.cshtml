@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<section class="page-shell">
    <div class="notice-bar">
        <p>The LM website includes both current and archived content, identified by publication date. Archived content is not actively updated or regularly reviewed. This may result in hyperlinks or other interactive elements no longer functioning as intended. Archived content may also contain references and/or text which no longer apply because of changes in law, regulation, or administration.</p>
    </div>

    <div class="container py-3">
        <div class="lm-tabs d-flex flex-wrap gap-2">
            <a asp-page="/Index" class="tab-btn @(Model.ActiveTab == "LM" ? "active" : "")">LM Sites</a>
            <a asp-page="/ConsideredSites" class="tab-btn @(Model.ActiveTab == "Considered" ? "active" : "")">Considered Sites</a>
            <a asp-page="/CerclaArPd" class="tab-btn @(Model.ActiveTab == "CERCLA" ? "active" : "")">CERCLA AR/PD</a>
            <a asp-page="/Search" class="tab-btn tab-secondary">Search</a>
        </div>
    </div>

    <div class="container py-4">
        <div class="row g-3 align-items-center">
            <div class="col-12 col-md-auto">
                <label for="siteSelect" class="col-form-label fw-semibold">Select Site:</label>
            </div>
            <div class="col-12 col-md-6 col-lg-4">
                <select id="siteSelect" class="form-select shadow-sm site-select">
                    <option selected disabled>Select</option>
                    @foreach (var site in Model.Locations)
                    {
                        <option value="@site">@site</option>
                    }
                </select>
            </div>
        </div>

        <div class="row mt-4">
            <div class="col-12 text-center">
                <h5 id="siteTitle" class="mb-0 fw-bold text-uppercase text-dark"></h5>
            </div>
        </div>

        <div class="row mt-4">
            <div class="col-12">
                <h5 class="fw-semibold">Key Documents</h5>
                <div class="table-responsive">
                    <table class="table table-sm table-striped align-middle mb-4" id="keyDocsTable">
                        <thead class="table-primary">
                            <tr>
                                <th style="width: 4rem;">File</th>
                                <th>Document Title</th>
                                <th style="width: 12rem;">Document Category</th>
                                <th style="width: 8rem;">State</th>
                                <th style="width: 10rem;">Date Posted</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
                <div id="keyDocsPagination" class="d-flex align-items-center justify-content-center gap-2 py-2" style="display: none;"></div>
            </div>
        </div>

        <div class="row mt-2">
            <div class="col-12">
                <h5 class="fw-semibold">Site Documents</h5>
                <div class="table-responsive">
                    <table class="table table-sm table-striped align-middle" id="siteDocsTable">
                        <thead class="table-primary">
                            <tr>
                                <th style="width: 4rem;">File</th>
                                <th>Document Title</th>
                                <th style="width: 12rem;">Document Category</th>
                                <th style="width: 8rem;">State</th>
                                <th style="width: 10rem;">Date Posted</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
                <div id="siteDocsPagination" class="d-flex align-items-center justify-content-center gap-2 py-2" style="display: none;"></div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        (function () {
            const KEY_DOCS_PAGE_SIZE = 20;
            const SITE_DOCS_PAGE_SIZE = 50;

            const siteSelect = document.getElementById('siteSelect');
            const siteTitle = document.getElementById('siteTitle');
            const keyDocsBody = document.querySelector('#keyDocsTable tbody');
            const siteDocsBody = document.querySelector('#siteDocsTable tbody');
            const keyDocsPaginationDiv = document.getElementById('keyDocsPagination');
            const siteDocsPaginationDiv = document.getElementById('siteDocsPagination');

            let keyDocsData = [];
            let siteDocsData = [];
            let keyDocsCurrentPage = 1;
            let siteDocsCurrentPage = 1;

            const renderDocRows = (tbody, docs) => {
                tbody.innerHTML = '';
                docs.forEach(doc => {
                    const row = document.createElement('tr');
                    const fileCell = document.createElement('td');
                    fileCell.textContent = '📄';
                    row.appendChild(fileCell);
                    const titleCell = document.createElement('td');
                    titleCell.textContent = doc.title || '';
                    row.appendChild(titleCell);
                    const catCell = document.createElement('td');
                    catCell.textContent = doc.category || '';
                    row.appendChild(catCell);
                    const stateCell = document.createElement('td');
                    stateCell.textContent = doc.state || '';
                    row.appendChild(stateCell);
                    const dateCell = document.createElement('td');
                    dateCell.textContent = doc.datePosted || '';
                    row.appendChild(dateCell);
                    tbody.appendChild(row);
                });
            };

            const renderKeyDocs = () => {
                if (!keyDocsData || keyDocsData.length === 0) {
                    keyDocsBody.innerHTML = '<tr><td colspan="5">No documents available.</td></tr>';
                    keyDocsPaginationDiv.style.display = 'none';
                    return;
                }
                const total = keyDocsData.length;
                if (total <= KEY_DOCS_PAGE_SIZE) {
                    renderDocRows(keyDocsBody, keyDocsData);
                    keyDocsPaginationDiv.style.display = 'none';
                    return;
                }
                const totalPages = Math.ceil(total / KEY_DOCS_PAGE_SIZE);
                const start = (keyDocsCurrentPage - 1) * KEY_DOCS_PAGE_SIZE;
                const end = Math.min(start + KEY_DOCS_PAGE_SIZE, total);
                renderDocRows(keyDocsBody, keyDocsData.slice(start, end));
                keyDocsPaginationDiv.style.display = 'flex';
                keyDocsPaginationDiv.innerHTML = '<button type="button" class="btn btn-sm btn-outline-secondary" id="keyDocsPrev" aria-label="Previous">&#8592;</button><span class="pagination-info">' + (start + 1) + ' - ' + end + '</span><button type="button" class="btn btn-sm btn-outline-secondary" id="keyDocsNext" aria-label="Next">&#8594;</button>';
                var prevBtn = keyDocsPaginationDiv.querySelector('#keyDocsPrev');
                var nextBtn = keyDocsPaginationDiv.querySelector('#keyDocsNext');
                if (prevBtn) prevBtn.disabled = keyDocsCurrentPage === 1;
                if (nextBtn) nextBtn.disabled = keyDocsCurrentPage === totalPages;
            };

            const renderSiteDocs = () => {
                if (!siteDocsData || siteDocsData.length === 0) {
                    siteDocsBody.innerHTML = '<tr><td colspan="5">No documents available.</td></tr>';
                    siteDocsPaginationDiv.style.display = 'none';
                    return;
                }
                const total = siteDocsData.length;
                if (total <= SITE_DOCS_PAGE_SIZE) {
                    renderDocRows(siteDocsBody, siteDocsData);
                    siteDocsPaginationDiv.style.display = 'none';
                    return;
                }
                const totalPages = Math.ceil(total / SITE_DOCS_PAGE_SIZE);
                const start = (siteDocsCurrentPage - 1) * SITE_DOCS_PAGE_SIZE;
                const end = Math.min(start + SITE_DOCS_PAGE_SIZE, total);
                renderDocRows(siteDocsBody, siteDocsData.slice(start, end));
                siteDocsPaginationDiv.style.display = 'flex';
                siteDocsPaginationDiv.innerHTML = '<button type="button" class="btn btn-sm btn-outline-secondary" id="siteDocsPrev" aria-label="Previous">&#8592;</button><span class="pagination-info">' + (start + 1) + ' - ' + end + '</span><button type="button" class="btn btn-sm btn-outline-secondary" id="siteDocsNext" aria-label="Next">&#8594;</button>';
                var prevBtn = siteDocsPaginationDiv.querySelector('#siteDocsPrev');
                var nextBtn = siteDocsPaginationDiv.querySelector('#siteDocsNext');
                if (prevBtn) prevBtn.disabled = siteDocsCurrentPage === 1;
                if (nextBtn) nextBtn.disabled = siteDocsCurrentPage === totalPages;
            };

            keyDocsPaginationDiv.addEventListener('click', function (e) {
                if (e.target.id === 'keyDocsPrev' && !e.target.disabled) { keyDocsCurrentPage--; renderKeyDocs(); }
                if (e.target.id === 'keyDocsNext' && !e.target.disabled) { keyDocsCurrentPage++; renderKeyDocs(); }
            });
            siteDocsPaginationDiv.addEventListener('click', function (e) {
                if (e.target.id === 'siteDocsPrev' && !e.target.disabled) { siteDocsCurrentPage--; renderSiteDocs(); }
                if (e.target.id === 'siteDocsNext' && !e.target.disabled) { siteDocsCurrentPage++; renderSiteDocs(); }
            });

            const clearAll = () => {
                siteTitle.textContent = '';
                keyDocsData = [];
                siteDocsData = [];
                keyDocsCurrentPage = 1;
                siteDocsCurrentPage = 1;
                renderKeyDocs();
                renderSiteDocs();
            };

            siteSelect?.addEventListener('change', async (e) => {
                const value = e.target.value;
                if (!value) {
                    clearAll();
                    return;
                }
                siteTitle.textContent = value + ' Site';

                try {
                    const resp = await fetch('?handler=Documents&site=' + encodeURIComponent(value));
                    if (!resp.ok) throw new Error('Request failed');
                    const data = await resp.json();
                    keyDocsData = data.keyDocuments || [];
                    siteDocsData = data.siteDocuments || [];
                    keyDocsCurrentPage = 1;
                    siteDocsCurrentPage = 1;
                    renderKeyDocs();
                    renderSiteDocs();
                } catch (err) {
                    clearAll();
                }
            });
        })();
    </script>
}
